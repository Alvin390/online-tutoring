# ===========================================================================
# CLIENT-SIDE (VITE_*) — these are compiled into the browser bundle.
# Everything here is PUBLIC by construction. Never put a secret in a VITE_ var.
# ===========================================================================

# Firebase Configuration
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef123456
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Sentry (Error Tracking)
VITE_SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id

# App Configuration
VITE_APP_NAME=Online Tutoring Platform
VITE_APP_VERSION=2.0.0
VITE_ENABLE_ANALYTICS=true
VITE_LOG_LEVEL=info

# Paystack PUBLIC key. Safe in the bundle by design — a public key can only
# initiate a transaction, never query or refund one.
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx


# ===========================================================================
# SERVER-SIDE — Vercel encrypted environment variables ONLY.
# No VITE_ prefix, so Vite cannot expose them to the browser even by accident.
# Set these in the Vercel dashboard, not in a committed file.
# ===========================================================================

# Firebase Admin service account JSON. Either the raw JSON on one line, or
# base64-encoded (preferred — avoids quoting problems in shells and CI).
#   Generate: Firebase Console > Project Settings > Service Accounts
#   Encode:   base64 -w0 serviceAccount.json
FIREBASE_SERVICE_ACCOUNT=

# 32 random bytes, base64. Encrypts third-party credentials at rest
# (Daraja consumer key/secret/passkey, from Phase 09).
#   Generate: openssl rand -base64 32
APP_ENCRYPTION_KEY=

# --- Paystack (Phase 03) ---
# Secret key. Enable IP whitelisting on it in the Paystack dashboard once the
# Vercel egress ranges are known.
PAYSTACK_SECRET_KEY=
# Plan codes, created once in the Paystack dashboard. Never hardcode amounts —
# the server reads the tier price from the plan, so a client cannot supply one.
PAYSTACK_PLAN_BRONZE=
PAYSTACK_PLAN_SILVER=
PAYSTACK_PLAN_GOLD=
# Public origin, used to build Paystack callback URLs.
PUBLIC_BASE_URL=https://your-deployment.vercel.app

# --- Cron (Phase 03) ---
# Shared secret asserted by the scheduled subscription sweep, so the endpoint
# cannot be driven by anyone who finds the URL.
#   Generate: openssl rand -base64 32
CRON_SECRET=

# --- Superadmin bootstrap (Phase 02) ---
# Consumed once by `npm run seed:superadmin`, then removed.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
