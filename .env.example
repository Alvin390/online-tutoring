# ===========================================================================
#  online-tutoring -- environment template
#
#  Two halves, and the split matters:
#
#    VITE_*   compiled INTO the browser bundle. Public by construction.
#             Never put a secret here -- anyone can read it in devtools.
#    others   server-side only, used by /api handlers and scripts.
#
#  Copy to .env.local and fill in. .env.local is gitignored.
#  In production set the same names as ENCRYPTED environment variables in the
#  Vercel dashboard.
#
#  Check everything is wired up with:  npm run health
# ===========================================================================


# ---------------------------------------------------------------------------
#  Firebase -- client SDK
#  Firebase Console > Project settings > General > Your apps
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=


# ---------------------------------------------------------------------------
#  Firebase Admin -- server side
#
#  Firebase Console > Project settings > Service accounts > Generate new
#  private key. Paste the JSON on ONE line, or base64-encode it (easier):
#    certutil -encode serviceAccount.json tmp.b64   (Windows)
#    base64 -w0 serviceAccount.json                 (Linux/macOS)
#
#  Without this, every /api route and every script fails.
# ---------------------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT=


# ---------------------------------------------------------------------------
#  App configuration
# ---------------------------------------------------------------------------
VITE_APP_NAME=Online Tutoring Platform
VITE_APP_VERSION=2.0.0
VITE_ENABLE_ANALYTICS=true
VITE_LOG_LEVEL=debug

# Public origin. Used to build Paystack callbacks, the Daraja callback URL and
# calendar subscription links. NO trailing slash.
#   local:      http://localhost:5173
#   production: https://your-app.vercel.app
PUBLIC_BASE_URL=http://localhost:3000

# Sentry error tracking. Leave empty to disable.
VITE_SENTRY_DSN=


# ---------------------------------------------------------------------------
#  Secrets -- GENERATED, do not edit by hand
# ---------------------------------------------------------------------------

# AES-256-GCM key encrypting the Daraja credentials at rest.
# CHANGING THIS MAKES EXISTING ENCRYPTED CREDENTIALS UNREADABLE -- you would
# have to re-enter them. 32 bytes, base64.
APP_ENCRYPTION_KEY=

# Shared secret the scheduled jobs must present. Without it every cron
# endpoint returns 401 and NOTHING runs -- no subscription expiry, no overdue
# sweep, no M-Pesa reconciliation.
CRON_SECRET=


# ===========================================================================
#  PAYSTACK  --  teacher subscriptions
#
#  PAYSTACK_MODE picks which key set is used:
#    dev   -> *_TEST keys, test cards, no real money
#    live  -> *_LIVE keys, real charges
#
#  Both sets can be filled in at once; the mode decides. Switching is one
#  word, with no key shuffling and no risk of leaving a live key active.
#
#  Keys: Paystack Dashboard > Settings > API Keys & Webhooks
#  Plans: Dashboard > Plans. Create three per mode (KES, monthly):
#    Bronze 4,999   Silver 7,499   Gold 9,999
#  Test-mode and live-mode plans are DIFFERENT objects with different codes.
# ===========================================================================
PAYSTACK_MODE=dev
VITE_PAYSTACK_MODE=dev

# --- test / sandbox ---
PAYSTACK_SECRET_KEY_TEST=
VITE_PAYSTACK_PUBLIC_KEY_TEST=
PAYSTACK_PLAN_BRONZE_TEST=
PAYSTACK_PLAN_SILVER_TEST=
PAYSTACK_PLAN_GOLD_TEST=

# --- live ---
PAYSTACK_SECRET_KEY_LIVE=
VITE_PAYSTACK_PUBLIC_KEY_LIVE=
PAYSTACK_PLAN_BRONZE_LIVE=
PAYSTACK_PLAN_SILVER_LIVE=
PAYSTACK_PLAN_GOLD_LIVE=


# ===========================================================================
#  M-PESA DARAJA  --  student fee payments
#
#  DARAJA_MODE picks which credential set is used:
#    dev   -> sandbox.safaricom.co.ke, test till, no real money
#    live  -> api.safaricom.co.ke, real money to the teacher's till
#
#  Credentials can come from two places, checked in this order:
#    1. the variables below, when they match the current mode  (convenient
#       for local testing -- no UI round trip)
#    2. integrations/daraja in Firestore, AES-256-GCM encrypted, entered by
#       the teacher through the credentials form  (the production path)
#
#  Sandbox setup: developer.safaricom.co.ke > My Apps > create an app, then
#  Simulator for the test passkey. The sandbox shortcode is 174379.
#
#  Going live is per teacher and needs Safaricom approval -- days, sometimes
#  longer. See docs/LAUNCH.md.
# ===========================================================================
DARAJA_MODE=dev

# --- sandbox ---
DARAJA_SANDBOX_SHORTCODE=174379
DARAJA_SANDBOX_SHORTCODE_TYPE=paybill
DARAJA_SANDBOX_CONSUMER_KEY=
DARAJA_SANDBOX_CONSUMER_SECRET=
DARAJA_SANDBOX_PASSKEY=

# --- live ---
# shortcode type: 'till' -> CustomerBuyGoodsOnline, 'paybill' -> CustomerPayBillOnline
# Getting this wrong does not error; the STK prompt simply never arrives.
DARAJA_LIVE_SHORTCODE=
DARAJA_LIVE_SHORTCODE_TYPE=till
DARAJA_LIVE_CONSUMER_KEY=
DARAJA_LIVE_CONSUMER_SECRET=
DARAJA_LIVE_PASSKEY=

# Optional comma-separated override of Safaricom's callback IP allowlist.
# Leave empty to use the built-in list. Safaricom has changed these before.
DARAJA_CALLBACK_IPS=

# Optional. The secret embedded in the M-Pesa callback URL path. Leave empty
# and the server generates one on first use and stores it (Phase 13 / 04).
# Set it only to pin a known value.
DARAJA_CALLBACK_SECRET=

# Optional, LOCAL TESTING ONLY. Where Safaricom sends STK callbacks, instead of
# PUBLIC_BASE_URL. Locally PUBLIC_BASE_URL is http://localhost, which Safaricom
# REJECTS ("400.002.02 Invalid CallBackURL"), so in sandbox mode the STK request
# carries a public placeholder instead (below): the prompt reaches the phone and
# the payment is confirmed when you run `npm run mpesa:reconcile`. To get real
# callbacks, point an HTTPS tunnel at the API and put its URL here, e.g.
#   cloudflared tunnel --url http://localhost:8787
# Live mode always requires an HTTPS callback.
DARAJA_CALLBACK_BASE_URL=

# Optional, sandbox only. The placeholder CallBackURL sent instead of a
# localhost one (default https://example.com/local-dev-callback). It never
# carries the callback secret. Ignored in live mode.
DARAJA_SANDBOX_PLACEHOLDER_CALLBACK=


# ===========================================================================
#  EMAIL  --  bug report and feature request alerts (Phase 13 / 06)
#
#  Sent through the Gmail API from a dedicated Gmail account, so mail is
#  Google-signed (SPF/DKIM/DMARC pass) with no domain of our own. Setup,
#  step by step: docs/GMAIL_SETUP.md, then
#      npm run gmail:auth
#  which prints GMAIL_REFRESH_TOKEN. WHERE alerts go is NOT set here -- it is
#  edited on the superadmin Settings tab (default alvinmk06@gmail.com).
#  Without these, reports are still saved; only the email is skipped and the
#  Settings card says "Email not set up".
# ===========================================================================
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# The Gmail address that sends (the account you authorised in gmail:auth).
GMAIL_SENDER=


# ===========================================================================
#  SUPERADMIN
#
#  Used once by:  npm run seed:superadmin
#  These are also the credentials you sign in with at /superadmin.
#  Password must be at least 12 characters.
# ===========================================================================
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=


# ===========================================================================
#  DIAGNOSTICS AND TESTING  --  leave blank in production
# ===========================================================================
# Bucket for WhatsApp attachments (this project uses .firebasestorage.app).
FIREBASE_STORAGE_BUCKET=
# 'true' enforces Paystack's webhook IP allowlist; otherwise mismatches are logged.
PAYSTACK_ENFORCE_IP=
# '1' adds a Server-Timing header to API responses (local measurement only).
PERF_TIMING=
# 'true' returns the student OTP in the API response. NEVER set anywhere real.
EXPOSE_DEV_OTP=
# SUBREQUEST_BUDGET and SWEEP_BATCH_SIZE are tuning knobs in wrangler.jsonc `vars`.
